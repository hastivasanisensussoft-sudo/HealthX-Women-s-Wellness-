{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@healthx/shared": ["../../packages/shared/src/index.ts"],
      "@healthx/shared/*": ["../../packages/shared/src/*"],
      "@shared-assets/*": ["../../packages/shared/assets/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../../packages/shared/src"]
}
